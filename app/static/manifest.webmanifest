{
  "name": "grocious",
  "short_name": "grocious",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1d2021",
  "theme_color": "#1d2021",
  "icons": [
    {
      "src": "/static/brand/grocious-pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/brand/grocious-pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/inbox",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "text/html",
            "message/rfc822",
            "text/plain",
            ".eml",
            ".pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".heic"
          ]
        }
      ]
    }
  }
}
