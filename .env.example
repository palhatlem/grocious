# Optional private runtime directory; defaults to this checkout.
# GROCIOUS_HOME=/path/to/private/runtime
# Coop login (Auth0 + MFA)
COOP_USER=
COOP_PASSWORD=

# Trumf (NorgesGruppen: Kiwi/Meny/Spar/Joker)
TRUMF_PHONE=4712345678
TRUMF_PASSWORD=your-trumf-password
# Rema 1000 (Æ) — passwordless (SMS OTP), only the number is needed
REMA_PHONE=4712345678
# optional ntfy topic for summaries
# NTFY_URL=https://ntfy.example.com/your-topic

# Receipt inbox: providers are disabled without their credentials; never commit real keys.
GROCIOUS_LLM_DEFAULT=none
GROCIOUS_LLM_AUTO=0
GROCIOUS_LLM_MAX_IMAGE_PX=2000
GROCIOUS_LLM_CLAUDE_MODEL=claude-opus-5
GROCIOUS_LLM_CLAUDE_CHEAP_MODEL=claude-sonnet-5
GROCIOUS_LLM_OPENAI_MODEL=gpt-6-astra
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible gateway base URL, including /v1; route/region is operator-managed.
GROCIOUS_LLM_LITELLM_URL=
GROCIOUS_LLM_LITELLM_MODEL=
GROCIOUS_LLM_LITELLM_KEY=
GROCIOUS_OCR=none

# Optional IMAP IDLE worker (compose --profile mail). IMAP_HOST must be reachable from its container.
IMAP_HOST=
IMAP_PORT=1143
IMAP_USER=
IMAP_PASSWORD=
IMAP_SECURITY=starttls
TLS_VERIFY=1
IMAP_FOLDER=Grocious/Inbox
IMAP_DONE=Grocious/Done
IMAP_FAILED=Grocious/Failed
IMAP_IDLE_TIMEOUT=1500
